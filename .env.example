# Copy to .env in the repository root. Do not commit .env or private logs.
# Only loopback HTTP endpoints are accepted; no cloud-provider fallback.
# Claude Code/Codex are not runtime providers.
RC_OLLAMA_URL=http://127.0.0.1:11434
# Leave empty to select a locally installed, non-cloud Gemma model automatically.
# Example after downloading it yourself: RC_OLLAMA_MODEL=gemma3:4b
RC_OLLAMA_MODEL=
RC_DATA_DIR=./data
# Comma-separated local directories from which projects may be imported.
RC_IMPORT_ROOTS=./samples
RC_DOCKER_IMAGE=rootcause-runner:local
# Allowed timeout ranges: tests 1..600 seconds, AI 1..900 seconds per request.
RC_TEST_TIMEOUT=120
RC_AI_TIMEOUT=180
# Explicit opt-in: only immutable bundled demo snapshots may execute locally.
# Imported projects and Live AI patches always require Docker.
RC_ENABLE_TRUSTED_DEMO_RUNNER=false
